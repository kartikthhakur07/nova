# NOVA — Environment Variables


# ─── App ──────────────────────────────────────────────────────────────────
APP_ENV=development                # development | production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173   # used for CORS + WebSocket origin check
SESSION_SECRET=replace_with_a_long_random_string   # signs/validates session ids

# ─── LLM ──────────────────────────────────────────────────────────────────
# Primary path: hackathon-provided hosted API credits, if available.
# Leave LLM_PROVIDER=ollama and the two keys blank to use the guaranteed-free
# local fallback instead (see backend/llm/client.py).
LLM_PROVIDER=ollama                 # ollama | openai | anthropic | google
LLM_MODEL=llama3.1:8b               # e.g. llama3.1:8b (ollama) or a hosted model name
LLM_API_KEY=                        # required only if LLM_PROVIDER is a hosted option
LLM_API_BASE_URL=                   # optional override, e.g. custom hosted endpoint
OLLAMA_HOST=http://localhost:11434  # used when LLM_PROVIDER=ollama

# ─── Embeddings & Reranking (local, no key required) ──────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# ─── ASR (local, no key required) ──────────────────────────────────────────
ASR_MODEL=small.en                  # faster-whisper model size

# ─── Rime (voice synthesis) ────────────────────────────────────────────────
RIME_API_KEY=replace_with_your_rime_api_key
RIME_MODEL_LIVE=mist-v3             # low-latency streaming path (proactive calls)
RIME_MODEL_DEBRIEF=coda             # optional, non-time-critical narration only
RIME_API_BASE_URL=https://users.rime.ai

# ─── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333    # local binary/Docker for dev
QDRANT_API_KEY=                     # required only for Qdrant Cloud, blank for local
QDRANT_COLLECTION_PREFIX=vigil_     # optional namespacing if sharing a cluster

# ─── SQLite ─────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=./backend/vigil.db

# ─── Data simulator ─────────────────────────────────────────────────────────
SIMULATOR_MODE=scripted             # scripted | live_interval
SIMULATOR_DEFAULT_SCENARIO=hero_scenario

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info                      # debug | info | warning | error

